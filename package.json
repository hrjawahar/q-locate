{
  "name": "q-locate",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "cf": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply q-locate-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply q-locate-db --remote",
    "db:seed:local": "wrangler d1 execute q-locate-db --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute q-locate-db --remote --file=seed/seed.sql"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "minisearch": "^7.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.143.0"
  },
  "private": true,
  "type": "module"
}
